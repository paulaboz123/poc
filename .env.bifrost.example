# GATEWAY settings: Claude on Amazon Bedrock via the Bifrost gateway; search stays local.
# Copy this file to .env and paste the 3 values from the platform team's e-mail.
# Never commit .env and never paste the key into chat or Teams.

# --- From the e-mail ---------------------------------------------------------------------
# The address from the e-mail, as it is (the "/anthropic" ending is fine, it is removed automatically)
BIFROST_BASE_URL=
# The virtual key
BIFROST_API_KEY=
# The Sonnet 5 model id (EU), exactly as in the e-mail, e.g. bedrock/eu.anthropic.claude-sonnet-...
CHAT_MODEL=

# --- Which backend does each job ---------------------------------------------------------
CHAT_BACKEND=bifrost
# Slides are read by the same Claude model (VISION_MODEL defaults to CHAT_MODEL)
VISION_BACKEND=bifrost
# Search runs on the laptop: Claude cannot make embeddings. Needs: ollama pull nomic-embed-text
EMBED_BACKEND=ollama
EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# --- Spending lock (estimates, logged in cost_log.csv) ---------------------------------------
# Stop all gateway calls for today at this amount. Can never be set above 100 (fixed in code).
DAILY_BUDGET_USD=20
# Stop one command (e.g. one video) at this amount
RUN_BUDGET_USD=5

# --- Gateway details (change only if something fails) -----------------------------------------
# How the key is sent: auto (Authorization: Bearer + x-bf-vk), authorization, x-bf-vk, x-api-key
BIFROST_AUTH_HEADER=auto
# Which gateway API: auto (OpenAI-style, falls back to the Anthropic route), openai, anthropic
GATEWAY_API=auto
# Only if you get CERTIFICATE_VERIFY_FAILED: path to the company CA bundle (.pem)
# CA_BUNDLE=
MAX_OUTPUT_TOKENS=6000
MAX_MATERIAL_WORDS=9000
# Search: scores below this = "not covered" (nomic-embed-text scale). Check with index.py search.
MIN_SCORE=0.45

# --- Recordings ----------------------------------------------------------------------------
PIPELINE_MODE=easy
OCR_LANG=eng
# Slide area in the recording, fractions left,top,right,bottom (empty = whole frame)
SLIDE_CROP=
# Part of the slide to hide in the video lesson (presenter camera on the slide), e.g. 0.72,0.62,1,1
SLIDE_MASK=
WHISPER_MODEL=small

# --- Voice and video ---------------------------------------------------------------------
# kokoro = natural local voice (uv run tts.py --download, once); system = Windows voice
TTS_ENGINE=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.0
VIDEO_WIDTH=1280
