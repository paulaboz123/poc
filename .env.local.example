# LOCAL settings: everything runs on this laptop with Ollama. No key, no cost, no data leaves the laptop.
# Copy this file to .env. Models: Meta (Llama), Google (Gemma), Nomic - no models of Chinese origin.
# Once:  ollama pull llama3.1:8b   ollama pull nomic-embed-text   (optional: ollama pull gemma3:4b)

CHAT_BACKEND=ollama
VISION_BACKEND=ollama
EMBED_BACKEND=ollama
OLLAMA_URL=http://localhost:11434

# Writes lessons and storyboards. If it is too slow on your laptop: llama3.2:3b (faster, weaker)
CHAT_MODEL=llama3.1:8b
# Describes slides (only with pipeline.py --vision; slow on a CPU, optional)
VISION_MODEL=gemma3:4b
# Search
EMBED_MODEL=nomic-embed-text

# Context window and answer length for local models (keep NUM_CTX >= material + answer)
NUM_CTX=16384
MAX_OUTPUT_TOKENS=4096
MAX_MATERIAL_WORDS=3000
# Search: scores below this = "not covered" (nomic-embed-text scale). Check with index.py search.
MIN_SCORE=0.45

# --- Recordings ---------------------------------------------------------------------------
PIPELINE_MODE=easy
OCR_LANG=eng
# Slide area in the recording, fractions left,top,right,bottom (empty = whole frame)
SLIDE_CROP=
# Part of the slide to hide in the video lesson (presenter camera on the slide), e.g. 0.72,0.62,1,1
SLIDE_MASK=
WHISPER_MODEL=small

# --- Voice and video ---------------------------------------------------------------------
# kokoro = natural local voice (uv run tts.py --download, once); system = Windows voice
TTS_ENGINE=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.0
VIDEO_WIDTH=1280
