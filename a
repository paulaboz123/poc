lint-chart:
  stage: check
  image:
    name: $HELM_IMAGE
    entrypoint: [""]
  script:
    - helm dependency update "$CHART"
    - helm template proto-learning-agent "$CHART" -f "$CHART/values.yaml" -f "$VALUES_FILE"
      --namespace <ten sam co u nich> --set app.image.repository=check --set app.image.tag=check > /dev/null
  rules:
    - if: $CI_COMMIT_BRANCH == $BUMP_BRANCH
      when: never
    - if: $CI_PIPELINE_SOURCE == "push" || $CI_PIPELINE_SOURCE == "web"


###

auth:
  proxyHeader: X-Forwarded-Email
